# orca-wrapper environment
#
# Copy to ~/.config/orca-wrapper/env, mode 600 (install.sh does this for you
# on first run, including generating ORCA_WRAPPER_TOKEN and, when possible,
# ORCA_REPO_ID). Referenced by orca-wrapper.service via EnvironmentFile=.

# Static bearer token the GitHub Actions workflow sends as
# "Authorization: Bearer <token>". Required -- the server has no other auth
# and should refuse to start without it. Generate one with:
#   openssl rand -hex 32
ORCA_WRAPPER_TOKEN=

# Path to the orca CLI launcher written by gce-inventory.sh (it resolves the
# Linux AppImage's live mount, since nothing stable is on PATH for it).
# Optional -- defaults to $HOME/.local/bin/orca.
#ORCA_BIN=/home/guy_thitiwat/.local/bin/orca

# Orca's internal id for the repo this wrapper drives on this host, from:
#   orca repo list --json
# Required -- there is no safe default (a wrong id would act on the wrong
# checkout). install.sh auto-fills this only when Orca knows about exactly
# one repo.
ORCA_REPO_ID=

# owner/name of the GitHub repo this wrapper watches PR comments on.
# Optional -- defaults to shoutkol/shout.
#GITHUB_REPO=shoutkol/shout

# Token used to read/write PRs on GITHUB_REPO (comments, statuses). Optional
# -- when unset, the wrapper shells out to `gh auth token`, so `gh auth
# login` must already be done as the user running the service.
#GITHUB_TOKEN=

# Local port the wrapper binds on 127.0.0.1 (never 0.0.0.0 -- Caddy is the
# only thing that should reach it, see ../Caddyfile). Optional -- defaults
# to 8787. Change Caddyfile's reverse_proxy target to match if you change
# this.
#PORT=8787

# Path to the wrapper's SQLite database (per-PR sessions + job queue).
# Optional -- defaults to $HOME/.local/share/orca-wrapper/state.sqlite.
#DB_PATH=

# Days a PR's session may sit idle before the wrapper garbage-collects it
# (removes the automation, closes its terminal, deletes the worktree).
# Optional -- defaults to 15.
#IDLE_DAYS=15

# Minutes a single agent turn may take before the wrapper gives up and posts
# a failure comment. Optional -- defaults to 60.
#RUN_TIMEOUT_MIN=60
